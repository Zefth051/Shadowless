1 ICON "@SHADOWLESS_ICON_PATH@"

1 VERSIONINFO
FILEVERSION @SHADOWLESS_VERSION_RESOURCE@
PRODUCTVERSION @SHADOWLESS_VERSION_RESOURCE@
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Shadowless"
            VALUE "FileVersion", "@SHADOWLESS_VERSION@"
            VALUE "ProductName", "Shadowless"
            VALUE "ProductVersion", "@SHADOWLESS_VERSION@"
            VALUE "OriginalFilename", "Shadowless.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
