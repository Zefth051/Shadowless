    <file alias="rose.ico">../../src/Shadowless/Assets/ShadowlessRose.ico</file>
    <file alias="amber.ico">../../src/Shadowless/Assets/ShadowlessAmber.ico</file>
    <file alias="moon.png">../../src/Shadowless/Assets/ShadowlessMoon.png</file>
    <file>chevron.svg</file>
    <file>chevron-up.svg</file>
    <file>icons/settings.svg</file>
    <file>icons/layers.svg</file>
    <file>icons/replay.svg</file>
