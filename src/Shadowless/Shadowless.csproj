<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Shadowless</AssemblyName>
    <AssemblyTitle>Shadowless - An app for clipping</AssemblyTitle>
    <Product>Shadowless</Product>
    <RootNamespace>Shadowless</RootNamespace>
    <ApplicationIcon>Assets\Shadowless.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.3.0</Version>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <DefineConstants Condition="'$(MicrosoftStoreBuild)' == 'true'">$(DefineConstants);MICROSOFT_STORE</DefineConstants>
    <EnablePublicUpdates Condition="'$(EnablePublicUpdates)' == '' and '$(Configuration)' == 'Release'">true</EnablePublicUpdates>
    <EnablePublicUpdates Condition="'$(EnablePublicUpdates)' == ''">false</EnablePublicUpdates>
    <DefineConstants Condition="'$(EnablePublicUpdates)' == 'true' and '$(MicrosoftStoreBuild)' != 'true'">$(DefineConstants);SHADOWLESS_PUBLIC_UPDATES</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\packaging\ExportDiagnostics.cmd" Link="ExportDiagnostics.cmd">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\docs\LOCAL_DIAGNOSTICS.md" Link="LOCAL_DIAGNOSTICS.md">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Resource Include="Assets\Shadowless.ico" />
    <Resource Include="Assets\ShadowlessAmber.ico" />
    <Resource Include="Assets\ShadowlessBlue.ico" />
    <Resource Include="Assets\ShadowlessInactive.ico" />
    <Resource Include="Assets\ShadowlessRose.ico" />
    <Resource Include="Assets\ShadowlessViolet.ico" />
    <EmbeddedResource Include="Assets\GameCatalog.json"
                      LogicalName="Shadowless.Assets.GameCatalog.json" />
    <EmbeddedResource Include="Assets\ReplaySaved.wav"
                      LogicalName="Shadowless.Assets.ReplaySaved.wav" />
    <Content Include="..\..\LICENSE" Link="LICENSE">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\README.md" Link="README.md">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <ObsRuntimeRoot>$(MSBuildProjectDirectory)\..\..\runtime\obs</ObsRuntimeRoot>
    <MpvRuntimeRoot>$(MSBuildProjectDirectory)\..\..\runtime\mpv</MpvRuntimeRoot>
    <FfmpegRuntimeRoot>$(MSBuildProjectDirectory)\..\..\runtime\ffmpeg</FfmpegRuntimeRoot>
    <AcquireObsRuntimeOnBuild Condition="'$(AcquireObsRuntimeOnBuild)' == ''">true</AcquireObsRuntimeOnBuild>
    <AcquireMpvRuntimeOnBuild Condition="'$(AcquireMpvRuntimeOnBuild)' == ''">true</AcquireMpvRuntimeOnBuild>
    <AcquireFfmpegRuntimeOnBuild Condition="'$(AcquireFfmpegRuntimeOnBuild)' == ''">true</AcquireFfmpegRuntimeOnBuild>
    <ObsBridgeSource>$(MSBuildProjectDirectory)\..\..\native\ObsBridge</ObsBridgeSource>
    <NativeBuildSuffix Condition="'$(NativeBuildSuffix)' == ''"></NativeBuildSuffix>
    <ObsBridgeBuild>$(ObsBridgeSource)\build$(NativeBuildSuffix)</ObsBridgeBuild>
    <ObsPluginSdkRoot>$(MSBuildProjectDirectory)\..\..\runtime\obs-sdk</ObsPluginSdkRoot>
    <ProcessAudioSource>$(MSBuildProjectDirectory)\..\..\native\ProcessAudio</ProcessAudioSource>
    <ProcessAudioBuild>$(ProcessAudioSource)\build$(NativeBuildSuffix)</ProcessAudioBuild>
    <NativeCmakeGenerator Condition="'$(NativeCmakeGenerator)' == ''">Visual Studio 17 2022</NativeCmakeGenerator>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="$(MpvRuntimeRoot)\libmpv-2.dll"
             Link="libmpv-2.dll">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="AcquireMpvRuntime"
          BeforeTargets="PrepareForBuild"
          Condition="'$(AcquireMpvRuntimeOnBuild)' == 'true' and !Exists('$(MpvRuntimeRoot)\libmpv-2.dll')">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\tools\AcquireMpvRuntime.ps1&quot;" />
  </Target>

  <Target Name="AcquireObsRuntime"
          BeforeTargets="PrepareForBuild"
          Condition="'$(AcquireObsRuntimeOnBuild)' == 'true' and (!Exists('$(ObsRuntimeRoot)\bin\obs.dll') or !Exists('$(ObsRuntimeRoot)\obs-plugins\64bit\image-source.dll') or !Exists('$(ObsRuntimeRoot)\obs-plugins\64bit\obs-filters.dll'))">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\tools\AcquireObsRuntime.ps1&quot;" />
  </Target>

  <Target Name="AcquireFfmpegRuntime"
          BeforeTargets="PrepareForBuild"
          Condition="'$(AcquireFfmpegRuntimeOnBuild)' == 'true' and !Exists('$(FfmpegRuntimeRoot)\ffmpeg.exe')">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\tools\AcquireFfmpegRuntime.ps1&quot;" />
  </Target>

  <Target Name="AcquireObsPluginSdk"
          BeforeTargets="PrepareForBuild">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\tools\AcquireObsPluginSdk.ps1&quot;" />
  </Target>

  <Target Name="CopyFfmpegRuntimeToBuild"
          AfterTargets="Build"
          DependsOnTargets="AcquireFfmpegRuntime">
    <ItemGroup>
      <_FfmpegBuildFile Include="$(FfmpegRuntimeRoot)\**\*"
                        Exclude="$(FfmpegRuntimeRoot)\ffplay.exe" />
    </ItemGroup>
    <Copy SourceFiles="@(_FfmpegBuildFile)"
          DestinationFiles="@(_FfmpegBuildFile->'$(OutDir)ffmpeg\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Delete Files="$(OutDir)ffmpeg\ffplay.exe" />
  </Target>

  <Target Name="CopyFfmpegRuntimeToPublish"
          AfterTargets="Publish"
          DependsOnTargets="AcquireFfmpegRuntime">
    <ItemGroup>
      <_FfmpegPublishFile Include="$(FfmpegRuntimeRoot)\**\*"
                          Exclude="$(FfmpegRuntimeRoot)\ffplay.exe" />
    </ItemGroup>
    <Copy SourceFiles="@(_FfmpegPublishFile)"
          DestinationFiles="@(_FfmpegPublishFile->'$(PublishDir)ffmpeg\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Delete Files="$(PublishDir)ffmpeg\ffplay.exe" />
  </Target>

  <Target Name="BuildObsBridge" BeforeTargets="Build">
    <Exec Condition="!Exists('$(ObsBridgeBuild)\ShadowlessObsBridge.sln')"
          Command="cmake -S &quot;$(ObsBridgeSource)&quot; -B &quot;$(ObsBridgeBuild)&quot; -G &quot;$(NativeCmakeGenerator)&quot; -A x64" />
    <Exec Command="cmake --build &quot;$(ObsBridgeBuild)&quot; --config Release --target ShadowlessObsBridge" />
  </Target>

  <Target Name="CopyObsBridge" AfterTargets="Build" DependsOnTargets="BuildObsBridge">
    <Copy SourceFiles="$(ObsBridgeBuild)\Release\ShadowlessObsBridge.dll"
          DestinationFolder="$(OutDir)" />
  </Target>

  <Target Name="CopyObsBridgeToPublish"
          AfterTargets="Publish"
          DependsOnTargets="BuildObsBridge"
          Condition="'$(PublishDir)' != ''">
    <Copy SourceFiles="$(ObsBridgeBuild)\Release\ShadowlessObsBridge.dll"
          DestinationFolder="$(PublishDir)" />
  </Target>

  <Target Name="BuildProcessAudioPlugin"
          BeforeTargets="Build"
          DependsOnTargets="AcquireObsPluginSdk">
    <Exec Condition="!Exists('$(ProcessAudioBuild)\ShadowlessProcessAudio.sln')"
          Command="cmake -S &quot;$(ProcessAudioSource)&quot; -B &quot;$(ProcessAudioBuild)&quot; -G &quot;$(NativeCmakeGenerator)&quot; -A x64 -DOBS_INCLUDE_DIR=&quot;$(ObsPluginSdkRoot)\include&quot;" />
    <Exec Command="cmake --build &quot;$(ProcessAudioBuild)&quot; --config Release --target ShadowlessProcessAudio" />
  </Target>

  <Target Name="CopyProcessAudioPlugin"
          AfterTargets="Build"
          DependsOnTargets="BuildProcessAudioPlugin">
    <Copy SourceFiles="$(ProcessAudioBuild)\Release\shadowless-process-audio.dll"
          DestinationFolder="$(OutDir)obs-plugins\64bit" />
  </Target>

  <Target Name="CopyProcessAudioPluginToPublish"
          AfterTargets="Publish"
          DependsOnTargets="BuildProcessAudioPlugin"
          Condition="'$(PublishDir)' != ''">
    <Copy SourceFiles="$(ProcessAudioBuild)\Release\shadowless-process-audio.dll"
          DestinationFolder="$(PublishDir)obs-plugins\64bit" />
  </Target>

  <ItemGroup>
    <Content Include="$(ObsRuntimeRoot)\VERSION">
      <Link>OBS_RUNTIME_VERSION</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(ObsRuntimeRoot)\SOURCE_SHA256">
      <Link>OBS_RUNTIME_SHA256</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(ObsRuntimeRoot)\bin\**\*">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(ObsRuntimeRoot)\obs-plugins\**\*">
      <Link>obs-plugins\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(ObsRuntimeRoot)\data\**\*">
      <Link>data\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
